//// Decision 594 — Every library runs at build on the wasm comptime runtime (434), jhonstart first; a function only Erlang or Node can run is a located error there.

import {io.terminal} from "std";
import {markdown} from "markdown";

fn render(source: string) -> string {
    return markdown.toHtml(markdown.parse(source));
}

pub fn main() -> void {
    val source = "# Release notes\n\nThe *reader* is botopink alone.\n";
    // Rendered at build, on the wasm comptime runtime, whatever `--target` is:
    // `markdown` is botopink alone, so every call it makes has a wasm form.
    val atBuild = comptime render("# Release notes\n\nThe *reader* is botopink alone.\n");
    // The same call at run time, on the program's target.
    val atRun = render(source);
    terminal.print(atBuild);
    terminal.print(atBuild == atRun, "\n");
}
